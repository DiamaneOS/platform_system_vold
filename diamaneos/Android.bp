package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// DiamaneOS: public FAT and exFAT volumes served from a protected VM (fs/Fsvm.cpp). Set by devices whose builds
// offer protected VMs. Without it vold mounts them in Android's kernel as before.
soong_config_module_type {
    name: "vold_diamaneos_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "diamaneos",
    bool_variables: ["fs_in_vm"],
    properties: ["cflags"],
}

vold_diamaneos_cc_defaults {
    name: "vold_fs_in_vm_defaults",
    // MediaProvider's uid for the files of a card the filesystem VM serves (fs/Fsvm.cpp MediaProviderUid).
    shared_libs: ["libpackagelistparser"],
    soong_config_variables: {
        fs_in_vm: {
            cflags: ["-DVOLD_PUBLIC_FS_IN_VM"],
        },
    },
}
