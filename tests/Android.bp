package {
    default_team: "trendy_team_android_kernel",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_test {
    name: "vold_tests",
    defaults: [
        "vold_default_flags",
        "vold_default_libs",
    ],

    srcs: [
        "Fsvm_test.cpp", // DiamaneOS: the filesystem VM's parser and checks
        "Utils_test.cpp",
        "VoldNativeServiceValidation_test.cpp",
    ],
    static_libs: ["libvold"],
    shared_libs: ["libbinder"],
}

cc_fuzz {
    name: "vold_native_service_fuzzer",
    defaults: [
        "vold_default_flags",
        "vold_default_libs",
        "keystore2_use_latest_aidl_ndk_shared",
        "service_fuzzer_defaults",
        "fuzzer_disable_leaks",
    ],
    static_libs: [
        "libvold",
        "android.security.maintenance-ndk",
        "libkeymint_support",
    ],
    header_libs: ["libvold_headers"],
    srcs: [
        "VoldFuzzer.cpp",
    ],
    corpus: ["vold_native_service_fuzzer_corpus/*"],
    fuzz_config: {
        cc: [
            "maco@google.com",
        ],
    },
}

// DiamaneOS: fsvmd's probe report as vold reads it (fs/Fsvm.cpp ParseLayout, the code itself, see
// vold_fsvm_layout_parser), on the host. Every report fsvmd writes from a layout it accepted (the corpus's
// FSVMD-OUTPUT files, from vendor/diamaneos fsvm/fuzz) must be accepted, and everything accepted must stay within the
// disk, clear of the partition tables, without overlaps or control characters.
cc_defaults {
    name: "vold_fsvm_layout_fuzz_defaults",
    srcs: ["FsvmLayoutFuzzer.cpp"],
    generated_headers: ["vold_fsvm_layout_parser"],
    include_dirs: ["system/vold"],
    header_libs: [
        "libcutils_headers",
        "libutils_headers",
    ],
    static_libs: [
        "libbase",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

cc_fuzz {
    name: "vold_fsvm_layout_fuzzer",
    defaults: ["vold_fsvm_layout_fuzz_defaults"],
    host_supported: true,
    device_supported: false,
    corpus: ["fsvm_layout_corpus/*"],
}

cc_test_host {
    name: "vold_fsvm_layout_corpus_test",
    defaults: ["vold_fsvm_layout_fuzz_defaults"],
    srcs: ["FsvmLayoutReplay.cpp"],
    cflags: ["-DFSVM_LAYOUT_REPLAY"],
    data: ["fsvm_layout_corpus/*"],
    test_suites: ["general-tests"],
}
